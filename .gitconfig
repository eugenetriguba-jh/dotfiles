[user]
	name = Eugene Triguba
	email = eugenetriguba@cap-rx.com
	signingkey = AB781277003B6037
[core]
	editor = vim
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	excludesfile = ~/.gitignore
[pull]
  ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = zebra
[init]
	defaultBranch = main
[commit]
    gpgsign = true
[tag]
    gpgSign = true
[gpg]
	program = gpg
[credential]
	helper = osxkeychain
